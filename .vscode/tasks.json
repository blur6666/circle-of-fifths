{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "preview: serve",
            "type": "process",
            "command": "py",
            "args": [
                "-m",
                "http.server",
                "4173",
                "--bind",
                "127.0.0.1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "circle-of-fifths-preview",
                "pattern": {
                    "regexp": "^(?!)$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Serving HTTP on .* port 4173",
                    "endsPattern": "^Serving HTTP on .* port 4173"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "clear": true
            },
            "runOptions": {
                "instanceLimit": 1
            }
        }
    ]
}
